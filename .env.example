# Local development settings. Copy to .env (git-ignored) and load it in the
# run target, for example with `dotenv: ['.env']` in the Taskfile.
#
# Local dev logs everything in human-readable form. Cluster environments set
# their own level and always log JSON: dev cluster debug, qa/staging info,
# production error.
LOG_LEVEL=trace
LOG_FORMAT=console

# A vault on its default local port, with the dev worker token; see
# docs/configuration.md for the rest.
VAULT_ADDR=localhost:9091
GRPC_PORT=9090
# Mutual TLS on the gRPC port and to the vault, when all three are set (plaintext
# otherwise). HEALTH_PORT (default 9091) is the plain health-only port the kubelet probes.
# MTLS_CERT_FILE=/etc/sneakers/mtls/tls.crt
# MTLS_KEY_FILE=/etc/sneakers/mtls/tls.key
# MTLS_CA_FILE=/etc/sneakers/mtls/ca.crt
# HEALTH_PORT=9091
# OTLP_LOGS_ENABLED=true
# OTLP_INSECURE_SKIP_VERIFY=true
# Serve the TLS certificate scan to any caller (local development only).
# WORKLOAD_AUTH=disabled
